<!-- 订单详情页面 -->
<view class="order-detail-page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 订单内容 -->
  <view wx:elif="{{order}}" class="order-content">
    <!-- 订单状态 -->
    <view class="status-section">
      <view class="status-icon">{{statusIcon}}</view>
      <view class="status-text">{{statusText}}</view>
      <view class="status-desc">{{statusDesc}}</view>
    </view>

    <!-- 餐桌信息 -->
    <view class="section table-section">
      <view class="section-title">餐桌信息</view>
      <view class="info-row">
        <text class="info-label">桌号</text>
        <text class="info-value">{{order.tableNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createTime}}</text>
      </view>
    </view>

    <!-- 菜品列表 -->
    <view class="section dishes-section">
      <view class="section-title">已点菜品</view>
      <view class="dishes-list">
        <view 
          wx:for="{{order.items}}" 
          wx:key="id"
          class="dish-item"
        >
          <view class="dish-info">
            <view class="dish-name">{{item.dishName}}</view>
          </view>
          <view class="dish-status {{order.paymentStatus === 0 ? '' : (item.status === 2 ? 'done' : '')}}">
            {{order.paymentStatus === 0 ? '待支付' : (item.status === 2 ? '已上桌' : '制作中')}}
          </view>
        </view>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="section fee-section">
      <view class="section-title">费用明细</view>
      <view class="fee-list">
        <view class="fee-item total">
          <text class="fee-label">合计</text>
          <text class="fee-value price">¥{{order.totalPrice}}</text>
        </view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section order-info-section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.orderNo || order.id}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createTime}}</text>
      </view>
      <view wx:if="{{order.updateTime}}" class="info-row">
        <text class="info-label">更新时间</text>
        <text class="info-value">{{order.updateTime}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view wx:if="{{order.paymentStatus === 0}}" class="pay-section">
      <button class="pay-btn" bindtap="onPay">去支付 ¥{{order.totalPrice}}</button>
    </view>

    <view class="action-section">
      <button
        class="btn-action btn-back"
        bindtap="onBack"
      >返回</button>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:else class="error-state">
    <view class="error-icon">❌</view>
    <view class="error-text">订单加载失败</view>
    <button class="btn-retry" bindtap="loadOrder">重试</button>
  </view>
</view>