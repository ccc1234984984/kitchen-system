/* 订单详情页面样式 */
.order-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
}

/* 订单状态 */
.status-section {
  background: linear-gradient(135deg, #c87a4f, #d4896a);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 通用section */
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 菜品列表 */
.dishes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
}

.dish-quantity {
  font-size: 26rpx;
  color: #999;
}

.dish-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #fff3e0;
  color: #ff9800;
}

.dish-status.done {
  background: #e8f5e9;
  color: #4caf50;
}

/* 费用明细 */
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fee-label {
  font-size: 28rpx;
  color: #666;
}

.fee-value {
  font-size: 28rpx;
  color: #333;
}

.fee-item.total {
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.fee-item.total .fee-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.fee-item.total .fee-value {
  font-size: 36rpx;
  font-weight: bold;
}

/* 支付按钮 */
.pay-section {
  padding: 30rpx 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.pay-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin: 0;
  background: #c87a4f;
  color: #fff;
}
.pay-btn::after { border: none; }

/* 操作按钮 */
.action-section {
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-action {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  margin: 0;
}

.btn-action::after {
  border: none;
}

.btn-back {
  background: #c87a4f;
  color: #fff;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.error-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.error-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 40rpx;
}

.btn-retry {
  background: #c87a4f;
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

.btn-retry::after {
  border: none;
}